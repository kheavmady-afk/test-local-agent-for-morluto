# ==============================================================================
# REA (Reverse Engineer Anything) Environment Configuration
# ==============================================================================
# Port Conflict Protection Notice:
# Common ports (80, 443, 3000-3003, 5000, 5432, 6379, 8080-8082, 8443, 9090, 9092)
# are reserved by other system microservices (e.g., can_law, floci, rengine, greenbone).
# REA services use isolated non-conflicting default ports below.
# ==============================================================================

# Docker Compose project name (groups containers under 'rea' namespace)
COMPOSE_PROJECT_NAME=rea

# REA Documentation & Showcase Web Server Port (Default: 4173)
REA_WEB_PORT=4173

# REA MCP Web Inspector UI Port (Default: 6274)
REA_INSPECTOR_PORT=6274
REA_SANDBOX_PORT=6275

# Local directory paths for targets and output artifacts
REA_TARGETS_DIR=../targets
REA_OUTPUT_DIR=../output

# Runtime log level (info | debug | error | silent)
REA_LOG_LEVEL=info

# Node environment
NODE_ENV=production
